# Console (Next.js). Every NEXT_PUBLIC_ value is visible to browsers: never put OPERATOR_TOKEN here.
# The operator token is typed into the console at runtime and kept in sessionStorage.

# API base URL (REST and socket.io /live namespace).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Maps JavaScript API key, restricted by HTTP referrer. Leave empty to use the schematic view.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Public address of this console, used for the QR code (phones must be able to reach it,
# e.g. http://192.168.1.20:3000 on the hotspot). Defaults to the browser's own origin.
NEXT_PUBLIC_PUBLIC_SITE_URL=

# Full URL of the report page for the QR code. Overrides NEXT_PUBLIC_PUBLIC_SITE_URL + /report.
NEXT_PUBLIC_REPORT_URL=
