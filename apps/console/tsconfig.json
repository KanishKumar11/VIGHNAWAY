{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "declaration": false,
    "sourceMap": false,
    "types": [
      "node",
      "google.maps"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next-e2e/types/**/*.ts",
    ".next-icon/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src",
    "test",
    "vitest.config.ts",
    ".next-hdr/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
