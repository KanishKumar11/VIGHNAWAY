# apps/mobile environment. Copy to .env.local (gitignored) or export before building.
# Native Google Maps SDK keys (app.config.ts). Restrict the Android key to package app.vighnaway
# plus the SHA-1 of every keystore that signs a build you run. Without a key the app shows its
# labelled schematic fallback instead of the map.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# Default API base URL (Settings > Server address overrides it on the phone).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Public address of the control-room console. Shared routes then include a decision-receipt link
# to <this>/verify (optional; without it a share carries only the receipt hash).
EXPO_PUBLIC_CONSOLE_URL=
# Set to 1 only for builds that reach the API over plain HTTP (laptop on the phone hotspot).
USE_CLEARTEXT=
