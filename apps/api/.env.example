# VIGHNAWAY API. Copy to apps/api/.env (git-ignored) or export in your shell; for Docker, put the
# same keys in infra/.env. The API reads process.env only (no dotenv loader).

# HTTP port and bind address.
PORT=4000
HOST=0.0.0.0
# Postgres with PostGIS. Tests use vighnaway_test (TEST_DATABASE_URL overrides it).
DATABASE_URL=postgres://vighnaway:vighnaway@127.0.0.1:5432/vighnaway
# Shared secret for operator and simulation actions. Server-side only: never in an EXPO_PUBLIC_
# or NEXT_PUBLIC_ variable, never committed. Empty = every operator/sim call is 401.
OPERATOR_TOKEN=
# Comma-separated browser origins allowed by CORS (HTTP and socket.io), e.g. the console.
CORS_ORIGINS=http://localhost:3000,https://vighnaway.app,https://www.vighnaway.app
# Salt for sha256(salt + deviceId) / sha256(salt + ip). Change it outside local development.
DEVICE_HASH_SALT=change-me-local-salt
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true when behind a reverse proxy (so per-IP throttling sees the client address).
TRUST_PROXY=false
# Report throttling per minute (defaults from docs/CONTRACTS.md).
REPORT_IP_LIMIT_PER_MIN=10
REPORT_DEVICE_LIMIT_PER_MIN=5
# Real ms per simulation tick (each tick advances simSecondsPerRealSecond). Tests only; keep 1000.
SIM_TICK_MS=1000

# Accounts (email one-time code). AUTH_SECRET keys the HMAC of every code: change it outside local
# development. ADMIN_EMAILS (comma-separated) always sign in as admin: how the first admin is made.
AUTH_SECRET=change-me-local-auth-secret
ADMIN_EMAILS=
# SMTP URL for the code email, e.g. smtps://user:app-password@smtp.gmail.com:465. Empty = the code is
# written to the API log (local development only); with NODE_ENV=production sign-in emails are refused.
SMTP_URL=
MAIL_FROM=VIGHNAWAY <no-reply@localhost>
OTP_TTL_S=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_S=60
OTP_MAX_PER_EMAIL_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=30
SESSION_TTL_WEB_HOURS=12
SESSION_TTL_MOBILE_DAYS=30

# Live traffic feed (optional; writes only to the live scenario). See docs/live-traffic.md.
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
TRAFFIC_FEED_SCENARIO=andheri-live
TRAFFIC_POLL_SECONDS=120
TRAFFIC_MATCH_DISTANCE_M=25
