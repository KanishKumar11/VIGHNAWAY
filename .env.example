# VIGHNAWAY environment. Copy the relevant lines into apps/api/.env, apps/console/.env.local and
# apps/mobile/.env (all gitignored). Domains, hosts and keys are configuration: everything runs
# locally without owning vighnaway.app. Run `pnpm preflight` after editing.

# --- API (apps/api/.env) ---
DATABASE_URL=postgres://vighnaway:vighnaway@127.0.0.1:5432/vighnaway
# Server-side only. Never in an EXPO_PUBLIC_ or NEXT_PUBLIC_ variable, never committed.
OPERATOR_TOKEN=
CORS_ORIGINS=http://localhost:3000
DEVICE_HASH_SALT=
PORT=4000
# Live traffic (optional; only the live scenario). See docs/live-traffic.md.
TOMTOM_API_KEY=
TRAFFIC_POLL_SECONDS=120
TRAFFIC_MATCH_DISTANCE_M=25

# --- Shared / deploy ---
API_BASE_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:3000
REPORT_URL=http://localhost:3000/report
# Proposed production values (only once DNS, TLS and hosting exist; .app is HTTPS-only):
# API_BASE_URL=https://api.vighnaway.app  PUBLIC_SITE_URL=https://vighnaway.app  REPORT_URL=https://vighnaway.app/report

# --- Console (apps/console/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Browser key restricted by HTTP referrer (localhost, the laptop's LAN address, vighnaway.app).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_REPORT_URL=

# --- Mobile (apps/mobile/.env, read by app.config.ts at build time) ---
# The laptop's LAN address on the phone hotspot; also editable in the app's Settings.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Android key restricted to package app.vighnaway + the SHA-1 of every keystore that signs a build.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# 1 only when the demo API is plain HTTP on the LAN (enables Android cleartext traffic).
USE_CLEARTEXT=1
