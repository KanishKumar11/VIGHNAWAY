{
  "name": "@vighnaway/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic route engine shared by the phone and the console. Pure functions, no clock, no I/O.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@vighnaway/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx --conditions=@vighnaway/source scripts/bench.ts",
    "docs:scoring": "tsx --conditions=@vighnaway/source scripts/gen-scoring-doc.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@vighnaway/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.20.5"
  }
}
