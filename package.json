{
  "name": "vighnaway",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node init && turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "node scripts/preflight.mjs",
    "docs:scoring": "pnpm --filter @vighnaway/engine run docs:scoring",
    "graph:fixture": "pnpm --filter @vighnaway/scenario-data run build:fixture",
    "scoreboard": "pnpm --filter @vighnaway/scenario-data scoreboard",
    "smoke": "node scripts/smoke-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
